# Neon Postgres (必須)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AT Protocol OAuth (必須)
# Bluesky OAuth クライアントメタデータの公開 URL
NEXT_PUBLIC_CLIENT_ID=https://bsky-gp.vercel.app/client-metadata.json
# OAuth コールバック URL
NEXT_PUBLIC_REDIRECT_URI=https://bsky-gp.vercel.app/api/auth/callback

# セッション暗号化キー（openssl rand -hex 32 で生成）
SESSION_SECRET=change-this-to-a-random-32-byte-hex-string

# サイト URL
NEXT_PUBLIC_SITE_URL=https://bsky-gp.vercel.app

# 開発者 Bluesky ハンドル（後から差し替え）
NEXT_PUBLIC_DEVELOPER_HANDLE=@your-handle.bsky.social

# Cron 保護トークン（openssl rand -hex 16 で生成）
CRON_SECRET=change-this-to-a-random-secret

# 管理者 API 認証トークン（openssl rand -hex 32 で生成）
# GET /api/admin/flagged, PATCH /api/admin/entries/[id]/ban で使用
ADMIN_SECRET=change-this-to-a-random-secret

# シーズン開始日（UTC、YYYY-MM-DD 形式）
# 未設定の場合は常にシーズン1として扱う
SEASON_START_DATE=2026-07-01

# 寄付リンク（任意）
NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=
NEXT_PUBLIC_KOFI_URL=

# ローカル開発用
# pnpm dev で起動する場合は localhost に変更
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_CLIENT_ID=http://localhost:3000/client-metadata.json
# NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/callback
